# Host-side test configuration. Copy to .env locally; never commit the real key.
# OpenRouter: leave the key blank to skip the live reasoning regression.
OPENROUTER_API_KEY=
INCIDENTOPS_TEST_LLM_MODEL=openai/gpt-6-luna

# PostgreSQL integration (local development credentials only)
INCIDENTOPS_TEST_DATABASE_URL=postgresql://incidentops_dev:incidentops_dev_only@127.0.0.1:5433/incidentops_test

# Synthetic services
INCIDENTOPS_TEST_INVENTORY_URL=http://127.0.0.1:8001
INCIDENTOPS_TEST_CHECKOUT_URL=http://127.0.0.1:8002

# MCP servers
INCIDENTOPS_TEST_OBSERVABILITY_MCP_URL=http://127.0.0.1:8003/mcp
INCIDENTOPS_TEST_OPERATIONS_MCP_URL=http://127.0.0.1:8004/mcp
